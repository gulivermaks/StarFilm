rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().size() <= 10;

      match /profiles/{profileId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId)
          && profileId.matches('^(main|p_[a-z0-9]{4,16})$')
          && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 24));

        match /library/{itemKey} {
          allow read: if isOwner(userId);
          allow write: if isOwner(userId)
            && itemKey.matches('^(movie|tv)_[0-9]{1,10}$')
            && request.resource.data.keys().size() <= 20
            && (!('mediaType' in request.resource.data) || request.resource.data.mediaType in ['movie', 'tv'])
            && (!('status' in request.resource.data) || request.resource.data.status in ['none', 'watchlist', 'watching', 'watched', 'dismissed'])
            && (!('sentiment' in request.resource.data) || request.resource.data.sentiment in ['neutral', 'liked', 'disliked'])
            && (!('title' in request.resource.data) || (request.resource.data.title is string && request.resource.data.title.size() <= 200))
            && (!('originalTitle' in request.resource.data) || (request.resource.data.originalTitle is string && request.resource.data.originalTitle.size() <= 200))
            && (!('posterPath' in request.resource.data) || (request.resource.data.posterPath is string && request.resource.data.posterPath.size() <= 160));
        }

        match /collections/{collectionId} {
          allow read: if isOwner(userId);
          allow write: if isOwner(userId)
            && collectionId.size() <= 48
            && (!('title' in request.resource.data) || (request.resource.data.title is string && request.resource.data.title.size() <= 60))
            && (!('mediaKeys' in request.resource.data) || (request.resource.data.mediaKeys is list && request.resource.data.mediaKeys.size() <= 500));
        }
      }
    }
  }
}
